using System;

class SimpleDijkstra
{
    static int FindMin(int[] dist, bool[] visited, int n)
    {
        int min = int.MaxValue, minIndex = -1;

        for (int i = 0; i < n; i++)
        {
            if (!visited[i] && dist[i] < min)
            {
                min = dist[i];
                minIndex = i;
            }
        }
        return minIndex;
    }

    static void Dijkstra(int[,] graph, int n, int start)
    {
        int[] dist = new int[n];
        bool[] visited = new bool[n];

        for (int i = 0; i < n; i++)
        {
            dist[i] = int.MaxValue;
            visited[i] = false;
        }

        dist[start] = 0;

        for (int count = 0; count < n - 1; count++)
        {
            int u = FindMin(dist, visited, n);
            visited[u] = true;

            for (int v = 0; v < n; v++)
            {
                if (!visited[v] && graph[u, v] != 0 && dist[u] != int.MaxValue && dist[u] + graph[u, v] < dist[v])
                {
                    dist[v] = dist[u] + graph[u, v];
                }
            }
        }

        Console.WriteLine("Shortest distances from node " + start + ":");
        for (int i = 0; i < n; i++)
        {
            Console.WriteLine($"To node {i} = {dist[i]}");
        }
    }

    static void Main()
    {
        int n = 5;
        int[,] graph = {
            { 0, 10, 0, 30, 100 },
            { 10, 0, 50, 0, 0 },
            { 0, 50, 0, 20, 10 },
            { 30, 0, 20, 0, 60 },
            { 100, 0, 10, 60, 0 }
        };

        Dijkstra(graph, n, 0); 
    }
}