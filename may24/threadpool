using System;
using System.Diagnostics;
using System.Runtime.InteropServices;
using System.Threading;
using System.Threading.Tasks;

class Program
{
    
    static void ProcessItem(object item)
    {
        
        Console.WriteLine($"threadpool processing item {item}");
        Thread.Sleep(500);
        Console.WriteLine($"threadpool processing item finished {item}");
    }
    

    static void Main(string[] args)
    {
        Console.WriteLine("adding items to threadpool \n");

        for(int i=1; i<=5; i++)
        {
            ThreadPool.QueueUserWorkItem(ProcessItem,i);
        }

        Thread.Sleep(1500);
        Console.WriteLine("\nall tasks done ");

    }
}