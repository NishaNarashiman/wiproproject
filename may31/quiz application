using System;
using System.Collections.Generic;

class Question
{
    public string Text { get; set; }
    public List<string> Options { get; set; }
    public int CorrectOption { get; set; }

    public bool Ask()
    {
        Console.WriteLine("\n" + Text);
        for (int i = 0; i < Options.Count; i++)
        {
            Console.WriteLine($"{i + 1}. {Options[i]}");
        }

        Console.Write("Your answer (1-4): ");
        int choice = int.Parse(Console.ReadLine() ?? "0");
        return (choice - 1) == CorrectOption;
    }
}

class Program
{
    static void Main()
    {
        var questions = new List<Question>
        {
            new Question
            {
                Text = "Which planet is known as the Red Planet?",
                Options = new List<string> { "Earth", "Mercury", "Mars", "Venus" },
                CorrectOption = 2
            },
            new Question
            {
                Text = "What is the Capital of India?",
                Options = new List<string> { "Mumbai", "Delhi", "Chennai", "Kolkata" },
                CorrectOption = 1
            },
            new Question
            {
                Text = "Who wrote 'Romeo and Juliet'?",
                Options = new List<string> { "Shakespeare", "Charles Dickens", "Leo Tolstoy", "Mark Twain" },
                CorrectOption = 0
            }
        };

        int score = 0;

        foreach (var q in questions)
        {
            if (q.Ask())
            {
                Console.WriteLine("Correct!");
                score++;
            }
            else
            {
                Console.WriteLine("Wrong!");
            }
        }

        Console.WriteLine($"\nYour score: {score} / {questions.Count}");
    }
}