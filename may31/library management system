using System;
using System.Collections.Generic;

class Book
{
    public int Id;
    public string Title;
    public bool IsBorrowed;
    public string BorrowedBy;
    public DateTime DueDate;
}

class Student
{
    public int Id;
    public string Name;
}

class Library
{
    List<Book> books = new List<Book>();
    List<Student> students = new List<Student>();

    public void AddBook(Book b)
    {
        books.Add(b);
        Console.WriteLine($"Added: {b.Title}");
    }

    public void AddStudent(Student s)
    {
        students.Add(s);
        Console.WriteLine($"Added student: {s.Name}");
    }

    public void BorrowBook(int bookId, int studentId, int days)
    {
        var book = books.Find(b => b.Id == bookId);
        var student = students.Find(s => s.Id == studentId);

        if (book == null || student == null)
        {
            Console.WriteLine("Book or Student not found.");
            return;
        }

        if (book.IsBorrowed)
        {
            Console.WriteLine("Book already borrowed.");
            return;
        }

        book.IsBorrowed = true;
        book.BorrowedBy = student.Name;
        book.DueDate = DateTime.Now.AddDays(days);

        Console.WriteLine($"{student.Name} borrowed '{book.Title}' for {days} days.");
    }

    public void DeleteBook(int bookId)
    {
        var book = books.Find(b => b.Id == bookId);

        if (book == null)
        {
            Console.WriteLine("Book not found.");
            return;
        }

        if (book.IsBorrowed)
        {
            Console.WriteLine("Cannot delete borrowed book.");
            return;
        }

        books.Remove(book);
        Console.WriteLine($"Deleted: {book.Title}");
    }

    public void ShowBooks()
    {
        Console.WriteLine("\nBooks List:");
        foreach (var book in books)
        {
            var status = book.IsBorrowed ? $"Borrowed by {book.BorrowedBy} (due {book.DueDate.ToShortDateString()})" : "Available";
            Console.WriteLine($"{book.Id}: {book.Title} - {status}");
        }
    }
}

class Program
{
    static void Main()
    {
        var library = new Library();

        
        library.AddBook(new Book { Id = 1, Title = "NEW DAY" });
        library.AddBook(new Book { Id = 2, Title = "C# PROGRAMMING" });

        
        library.AddStudent(new Student { Id = 1, Name = "Nisha" });
        library.AddStudent(new Student { Id = 2, Name = "Emily" });

        
        library.BorrowBook(1, 1, 7);
        library.BorrowBook(2, 2, 10);

        
        library.ShowBooks();

        
        library.DeleteBook(2);
        library.DeleteBook(1);

        
        
    }
}