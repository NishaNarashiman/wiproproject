using System;
using System.Collections.Generic;
using System.Linq;

class Student
{

    public string Name { get; set; }
    public double Mark { get; set; }
}
class Program
{
    static void Main()
    {
        List<Student> students = new List<Student>
        {
            new Student { Name = "alice", Mark = 80 },
            new Student { Name = "bob", Mark = 76 },
            new Student { Name = "charlie", Mark = 83 },
            new Student { Name = "david", Mark = 90 },
            new Student { Name = "emily", Mark = 92 },
            new Student { Name = "john", Mark = 89 },
        };

        var top3students = students.OrderByDescending(s=>s.Mark).Take(3).ToList();
        Console.WriteLine("top 3 students list:");
        foreach(var student in top3students)
        {
            Console.WriteLine($"Name: {student.Name}, Mark: {student.Mark}");
        }

    }
}