using System;
using System.Collections.Generic;

class Employee
{
    public int EmployeeID { get; set; }
    public string Name { get; set; }
    public decimal Salary { get; set; }

    public Employee(int id, string name, decimal salary)
    {
        EmployeeID = id;
        Name = name;
        Salary = salary;
    }
}

class Program
{
    static void Main()
    {
        //adding employees to the list
        List<Employee> employees = new List<Employee>
        {
            new Employee(101, "Alice", 50000),
            new Employee(102, "Bob", 60000),
            new Employee(103, "John", 70000),
            new Employee(104, "Noah", 80000),
            new Employee(105, "Emily", 90000)
        };

        //  employee with highest salary
        Employee highest = employees[0];
        foreach (var emp in employees)
        {
            if (emp.Salary > highest.Salary)
                highest = emp;
        }
        Console.WriteLine("Highest Paid: " + highest.Name + " - " + highest.Salary);

        // Store ID and Name in a dictionary
        Dictionary<int, string> empDict = new Dictionary<int, string>();
        foreach (var emp in employees)
        {
            empDict[emp.EmployeeID] = emp.Name; // fixed property name
        }

        // Display dictionary
        Console.WriteLine("\nEmployee Dictionary:");
        foreach (var pair in empDict)
        {
            Console.WriteLine("ID: " + pair.Key + ", Name: " + pair.Value);
        }

        // Search by ID
        Console.WriteLine("\nEnter ID to search:");
        int id = int.Parse(Console.ReadLine());

        if (empDict.ContainsKey(id))
            Console.WriteLine("Found: " + empDict[id]);
        else
            Console.WriteLine("Employee not found.");
    }
}