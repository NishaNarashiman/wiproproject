using System;
abstract class Book()
{
    public abstract void Read();
    public  void GetInfo()
    {
    Console.WriteLine("this is a book");
    }
   

}
class FictionBook : Book
{
    public override void Read()
    {
        Console.WriteLine("Readind a Fiction book");
    }
}
class ScienceBook : Book
{
    public override void Read()
    {
        Console.WriteLine("Readind a Science book");
    }
}
class Program
{
    static void Main()
    {
        Book fb = new FictionBook();
        Book sb = new ScienceBook();
        
        fb.GetInfo();
        fb.Read();
        sb.GetInfo();
        sb.Read();
    }
      

}