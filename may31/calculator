using System;

class Calculator
{
    public static int Add(int a, int b) => a + b;
    public static float Add(float a, float b) => a + b;
    public static double Add(double a, double b) => a + b;

    public static int Subtract(int a, int b) => a - b;
    public static float Subtract(float a, float b) => a - b;
    public static double Subtract(double a, double b) => a - b;

    public static int Multiply(int a, int b) => a * b;
    public static float Multiply(float a, float b) => a * b;
    public static double Multiply(double a, double b) => a * b;
}

class Program
{
    static void Main()
    {
        Console.WriteLine("Choose data type (int, float, double):");
        string type = Console.ReadLine();

        Console.WriteLine("Enter first number:");
        string input1 = Console.ReadLine();

        Console.WriteLine("Enter second number:");
        string input2 = Console.ReadLine();

        Console.WriteLine("Choose operation (Add, Subtract, Multiply):");
        string operation = Console.ReadLine();

        try
        {
            if (type == "int")
            {
                int i1 = int.Parse(input1);
                int i2 = int.Parse(input2);
                PerformIntOperation(i1, i2, operation);
            }
            else if (type == "float")
            {
                float f1 = float.Parse(input1);
                float f2 = float.Parse(input2);
                PerformFloatOperation(f1, f2, operation);
            }
            else if (type == "double")
            {
                double d1 = double.Parse(input1);
                double d2 = double.Parse(input2);
                PerformDoubleOperation(d1, d2, operation);
            }
            else
            {
                Console.WriteLine("Invalid data type.");
            }
        }
        catch
        {
            Console.WriteLine("Invalid number input.");
        }
    }

    static void PerformIntOperation(int a, int b, string op)
    {
        if (op == "Add")
            Console.WriteLine(Calculator.Add(a, b));
        else if (op == "Subtract")
            Console.WriteLine(Calculator.Subtract(a, b));
        else if (op == "Multiply")
            Console.WriteLine(Calculator.Multiply(a, b));
        else
            Console.WriteLine("Invalid operation.");
    }

    static void PerformFloatOperation(float a, float b, string op)
    {
        if (op == "Add")
            Console.WriteLine(Calculator.Add(a, b));
        else if (op == "Subtract")
            Console.WriteLine(Calculator.Subtract(a, b));
        else if (op == "Multiply")
            Console.WriteLine(Calculator.Multiply(a, b));
        else
            Console.WriteLine("Invalid operation.");
    }

    static void PerformDoubleOperation(double a, double b, string op)
    {
        if (op == "Add")
            Console.WriteLine(Calculator.Add(a, b));
        else if (op == "Subtract")
            Console.WriteLine(Calculator.Subtract(a, b));
        else if (op == "Multiply")
            Console.WriteLine(Calculator.Multiply(a, b));
        else
            Console.WriteLine("Invalid operation.");
    }
}